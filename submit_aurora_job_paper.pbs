#!/bin/bash
#PBS -N LLM-pretraining
#PBS -A Intel-Aurora
#PBS -q prod
#PBS -l select=256:ncpus=208
#PBS -l walltime=01:00:00
#PBS -l filesystems=flare

cd $PBS_O_WORKDIR

# Environment
module load frameworks
source fastmoe/bin/activate
source setenv_aurora_essential.sh

# OLMo
# PAPER=1 NUM_NODES=256 USE_OM_CACHED_MODEL=1 CONTEXT_SIZE=2048 MODEL_CHOICE=allenai/OLMo-1B-hf DATASET_CHOICE=allenai/OLMoE-mix-0924 USE_OM_SHARDED_OPTIMIZER=1 bash run_experiment.sh

# OLMoE
# PAPER=1 NUM_NODES=256 USE_OM_CACHED_MODEL=1 CONTEXT_SIZE=2048 MODEL_CHOICE=allenai/OLMoE-1B-7B-0924 DATASET_CHOICE=allenai/OLMoE-mix-0924 USE_FAST_MOE=1 USE_MERGED_MLP_IN_FAST_MOE=1 USE_OM_SHARDED_OPTIMIZER=1 bash run_experiment.sh

# OLMoE-L
# PAPER=1 NUM_NODES=256 DP_STAGGERED_CHECKPOINTING=1 USE_OM_CACHED_MODEL=1 CONTEXT_SIZE=2048 MODEL_CHOICE=allenai/OLMoE-1B-7B-0924--SE1.5-L32 DATASET_CHOICE=allenai/OLMoE-mix-0924 USE_FAST_MOE=1 USE_MERGED_MLP_IN_FAST_MOE=1 EP=12 USE_OM_PGSHARDED_OPTIMIZER=1 bash run_experiment.sh

# OLMoE-XL
# PAPER=1 NUM_NODES=256 DP_STAGGERED_CHECKPOINTING=1 USE_OM_CACHED_MODEL=1 CHECKPOINT_STEPS=500 CONTEXT_SIZE=2048 MODEL_CHOICE=allenai/OLMoE-1B-7B-0924--SA1.5-SH1.5-SE2.25-SI1.5-L48 DATASET_CHOICE=allenai/OLMoE-mix-0924 USE_FAST_MOE=1 USE_MERGED_MLP_IN_FAST_MOE=1 EP=12 PP=4 PP_SCHEME=1f1b BATCH_SIZE=4 ENABLE_SAC=1 SAC_LEVEL=1 USE_OM_PGSHARDED_OPTIMIZER=1 bash run_experiment.sh

# OLMoE-XXL
# PAPER=1 NUM_NODES=256 DP_STAGGERED_CHECKPOINTING=1 USE_OM_CACHED_MODEL=1 CHECKPOINT_STEPS=250 CONTEXT_SIZE=2048 MODEL_CHOICE=allenai/OLMoE-1B-7B-0924--SA1.5-SH1.5-SE3.75-SI1.5-L64 DATASET_CHOICE=allenai/OLMoE-mix-0924 USE_FAST_MOE=1 USE_MERGED_MLP_IN_FAST_MOE=1 EP=12 PP=8 PP_SCHEME=1f1b BATCH_SIZE=8 ENABLE_SAC=1 SAC_LEVEL=7 USE_OM_PGSHARDED_OPTIMIZER=1 bash run_experiment.sh 